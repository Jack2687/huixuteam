# Copy to .env on the server; never commit the actual configuration.
HUIXU_VERSION=local
HUIXU_BIND=0.0.0.0
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
MASTER_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
BOOTSTRAP_NAME=Admin
# Direct HTTP on 7825 uses false; set true when accessed exclusively over HTTPS.
COOKIE_SECURE=false
